# LandIQ environment configuration
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# ── Required ──────────────────────────────────────────────────────────
# Primary LLM provider. Free tier works: https://console.groq.com/keys
GROQ_API_KEY=

# ── Strongly recommended ──────────────────────────────────────────────
# Fallback provider, used automatically when Groq is rate-limited (429)
# or its daily quota is exhausted. https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── Optional: model overrides ─────────────────────────────────────────
# Defaults are used if left blank.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-latest

# ── Optional: additional providers ────────────────────────────────────
OPENROUTER_API_KEY=

# ── Optional: PixelRAG visual document reader ─────────────────────────
# Only needed if you run the visual-document agent with the
# Llama-Vision reader on Cloudflare Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# ── Optional: Langflow ────────────────────────────────────────────────
# Skips the Langflow login screen for local development.
LANGFLOW_AUTO_LOGIN=true

# ── Optional: credential encryption ───────────────────────────────────
# Used to encrypt provider credentials stored by the configurator.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
