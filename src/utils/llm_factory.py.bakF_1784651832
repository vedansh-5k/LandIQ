def _convert_messages_to_litellm(messages: List[BaseMessage]) -> List[Dict[str, str]]:
    litellm_messages = []
    for m in messages:
        if isinstance(m, tuple):
            role, content = m
        elif hasattr(m, "type"):
            role = "system" if m.type == "system" else "assistant" if m.type == "ai" else "user"
            content = m.content
        else:
            role = m.get("role", "user")
            content = m.get("content", "")
        litellm_messages.append({"role": role, "content": content})
    return litellm_messages


class RouterStructuredOutputLLM(RunnableSerializable[Any, Any]):
    router: Any
    config_name: str
    schema_to_validate: Any  # Pydantic model
    temperature: float = 0.3
    max_tokens: Optional[int] = None

    @property
    def lc_serializable(self) -> bool:
        return False

    def invoke(self, input: Any, config: Optional[dict] = None, **kwargs: Any) -> Any:
        if hasattr(input, "to_messages"):
            messages = input.to_messages()
        else:
            messages = input

        litellm_messages = _convert_messages_to_litellm(messages)

        schema_json = json.dumps(self.schema_to_validate.model_json_schema(), indent=2)
        instruction = f"\n\nYou MUST respond with a JSON object that strictly adheres to this JSON Schema:\n{schema_json}"

        if litellm_messages and litellm_messages[0]["role"] == "system":
            litellm_messages[0]["content"] += instruction
        else:
            litellm_messages.insert(0, {"role": "system", "content": instruction})

        last_err = None
        max_retries = 3
        for attempt in range(max_retries):
            try:
                resp = self.router.completion(
                    model=f"{self.config_name}::chat",
                    messages=litellm_messages,
                    temperature=self.temperature,
                    max_tokens=self.max_tokens or 4096,
                    response_format={"type": "json_object"}
                )
                content = resp.choices[0].message.content.strip()
                if content.startswith("```json"):
                    content = content[7:]
                if content.endswith("```"):
                    content = content[:-3]
                content = content.strip()

                return self.schema_to_validate.model_validate_json(content)
            except Exception as e:
                wait = 3 * (attempt + 1)  # 3, 6, 9
                print(f"  [ROUTER STRUCTURED RETRY {attempt+1}/{max_retries}] {str(e)[:120]} | wait {wait}s")
                last_err = e
                if attempt < max_retries - 1:
                    time.sleep(wait)
        raise last_err


class RouterChatModel(BaseChatModel):
    router: Any
    config_name: str
    temperature: float = 0.3
    max_tokens: Optional[int] = None

    @property
    def _llm_type(self) -> str:
        return "litellm_router"

    def _generate(
        self,
        messages: List[BaseMessage],
        stop: Optional[List[str]] = None,
        run_manager: Optional[CallbackManagerForLLMRun] = None,
        **kwargs: Any,
    ) -> ChatResult:
        litellm_messages = _convert_messages_to_litellm(messages)
        last_err = None
        for attempt in range(3):
            try:
                resp = self.router.completion(
                    model=f"{self.config_name}::chat",
                    messages=litellm_messages,
                    temperature=self.temperature,
                    max_tokens=self.max_tokens or 4096,
                    **kwargs
                )
                content = resp.choices[0].message.content
                ai_message = AIMessage(content=content)
                return ChatResult(generations=[ChatGeneration(message=ai_message)])
            except Exception as e:
                wait = 3 * (attempt + 1)  # 3, 6, 9
                print(f"  [ROUTER CHAT RETRY {attempt+1}/3] {str(e)[:100]} | wait {wait}s")
                last_err = e
                if attempt < 2:
                    time.sleep(wait)
        raise last_err

    def with_structured_output(
        self,
        schema: Any,
        *,
        include_raw: bool = False,
        **kwargs: Any,
    ) -> Any:
        return RouterStructuredOutputLLM(
            router=self.router,
            config_name=self.config_name,
            schema_to_validate=schema,
            temperature=self.temperature,
            max_tokens=self.max_tokens
        )



def _key(env_name: str, provider: str) -> str:
    key = _runtime_keys.get(provider, "") or os.getenv(env_name, "")
    if not key:
        try:
            from src.utils.db import get_db_connection
            with get_db_connection() as conn:
                row = conn.execute("SELECT api_key FROM global_models WHERE provider=? AND api_key IS NOT NULL AND api_key != '' LIMIT 1", (provider,)).fetchone()
                if row:
                    key = row[0]
                    # Cache it in environment so subsequent calls are fast
                    os.environ[env_name] = key
        except Exception:
            pass
    return key


class ExternalStudentChatModel(BaseChatModel):
    """Calls the student's LiteLLM server directly at /llm/{config}/chat.
    No localhost loopback, no ChatOpenAI path mangling."""
    config_name: str
    base_url: str
    temperature: float = 0.3
    max_tokens: Optional[int] = 4096

    @property
    def _llm_type(self) -> str:
        return "external_student_server"

    def _generate(self, messages, stop=None, run_manager=None, **kwargs) -> ChatResult:
        import requests
        payload = {
            "messages": _convert_messages_to_litellm(messages),
            "temperature": self.temperature,
            "max_tokens": self.max_tokens or 4096,
        }
        url = f"{self.base_url.rstrip('/')}/llm/{self.config_name}/chat"
        headers = {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-Tunnel-Skip-Auth-Redirect": "true",
        }
        last_err = None
        for attempt in range(3):
            try:
                r = requests.post(url, json=payload, headers=headers, timeout=60)
                if "html" in r.headers.get("content-type", ""):
                    raise RuntimeError("Student tunnel returned login page — set Port Visibility to Public")
                r.raise_for_status()
                data = r.json()
                content = data["choices"][0]["message"]["content"]
                return ChatResult(generations=[ChatGeneration(message=AIMessage(content=content))])
            except Exception as e:
                last_err = e
                print(f"  [EXTERNAL RETRY {attempt+1}/3] {str(e)[:100]}")
                if attempt < 2:
                    time.sleep(2 * (attempt + 1))
        raise last_err

    def with_structured_output(self, schema, *, include_raw: bool = False, **kwargs):
        return ExternalStructuredOutput(
            config_name=self.config_name,
            base_url=self.base_url,
            schema_to_validate=schema,
            temperature=self.temperature,
            max_tokens=self.max_tokens,
        )


class ExternalStructuredOutput(RunnableSerializable[Any, Any]):
    config_name: str
    base_url: str
    schema_to_validate: Any
    temperature: float = 0.3
    max_tokens: Optional[int] = 4096

    @property
    def lc_serializable(self) -> bool:
        return False

    def invoke(self, input: Any, config: Optional[dict] = None, **kwargs: Any) -> Any:
        import requests
        messages = input.to_messages() if hasattr(input, "to_messages") else input
        litellm_messages = _convert_messages_to_litellm(messages)

        schema_json = json.dumps(self.schema_to_validate.model_json_schema(), indent=2)
        instruction = (
            f"\n\nYou MUST respond with ONLY a valid JSON object matching this schema. "
            f"No markdown, no backticks, no explanation:\n{schema_json}"
        )
        if litellm_messages and litellm_messages[0]["role"] == "system":
            litellm_messages[0]["content"] += instruction
        else:
            litellm_messages.insert(0, {"role": "system", "content": instruction})

        url = f"{self.base_url.rstrip('/')}/llm/{self.config_name}/chat"
        headers = {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-Tunnel-Skip-Auth-Redirect": "true",
        }
        last_err = None
        for attempt in range(3):
            try:
                r = requests.post(url, json={
                    "messages": litellm_messages,
                    "temperature": self.temperature,
                    "max_tokens": self.max_tokens or 4096,
                }, headers=headers, timeout=60)
                r.raise_for_status()
                content = r.json()["choices"][0]["message"]["content"].strip()
                if content.startswith("```json"):
                    content = content[7:]
                if content.startswith("```"):
                    content = content[3:]
                if content.endswith("```"):
                    content = content[:-3]
                return self.schema_to_validate.model_validate_json(content.strip())
            except Exception as e:
                last_err = e
                print(f"  [EXTERNAL STRUCTURED RETRY {attempt+1}/3] {str(e)[:120]}")
                if attempt < 2:
                    time.sleep(2 * (attempt + 1))
        raise last_err


def _build_external_llm(config_name: str, temperature: float):
    """Build a LangChain model that calls the student's server directly."""
    base = getattr(_tls, "external_base", "") or os.environ.get("EXTERNAL_LLM_BASE", "")
    base = base.strip().rstrip("/")
    if not base:
        raise RuntimeError("No external base URL set for external config")
    print(f"  [LLM] External '{config_name}' -> {base}/llm/{config_name}/chat | temp={temperature}")
    return ExternalStudentChatModel(
        config_name=config_name,
        base_url=base,
        temperature=temperature,
        max_tokens=4096,
    )


def _build_llm(model_entry: dict, final_temp: float):
    """
    Builds the correct LangChain object for a model entry.
    model_entry comes from llm_configurator — has provider, model, etc.
    """
    provider = model_entry.get("provider", "groq").lower()
    model    = model_entry["model"]

    if provider == "groq":
        from langchain_groq import ChatGroq
        return ChatGroq(
            api_key=_key("GROQ_API_KEY", "groq"),
            model=model,
            temperature=final_temp
        )

    if provider in ("google", "gemini"):
        from langchain_google_genai import ChatGoogleGenerativeAI
        return ChatGoogleGenerativeAI(
            model=model,
            google_api_key=_key("GOOGLE_API_KEY", "google"),
            temperature=final_temp,
        )

    if provider == "anthropic":
        from langchain_anthropic import ChatAnthropic
        return ChatAnthropic(
            model=model,
            anthropic_api_key=_key("ANTHROPIC_API_KEY", "anthropic"),
            temperature=final_temp,
            max_tokens=2048
        )

    if provider == "openai":
        from langchain_openai import ChatOpenAI
        return ChatOpenAI(
            model=model,
            api_key=_key("OPENAI_API_KEY", "openai"),
            temperature=final_temp
        )

    if provider == "mistral":
        from langchain_mistralai import ChatMistralAI
        return ChatMistralAI(
            model=model,
            api_key=_key("MISTRAL_API_KEY", "mistral"),
            temperature=final_temp
        )

    if provider == "deepseek":
        from langchain_openai import ChatOpenAI
        return ChatOpenAI(
            model=model,
            api_key=_key("DEEPSEEK_API_KEY", "deepseek"),
            base_url="https://api.deepseek.com/v1",
            temperature=final_temp
        )

    # Final fallback — Groq Llama always works
    print(f"  [LLM] '{provider}' not configured -> Groq Llama fallback")
    from langchain_groq import ChatGroq
    return ChatGroq(
        api_key=os.getenv("GROQ_API_KEY", ""),
        model="llama-3.3-70b-versatile",
        temperature=final_temp
    )


def get_llm_for_agent(agent_name: str, temperature: float = 0.3):
    """
    Main function called by every agent.
    Returns a ready-to-use LangChain LLM object.
    Handles: per-agent temperature, provider routing, auto-fallback,
    and external student server configs.
    """
    # Get per-agent temperature
    try:
        from src.utils.agent_configurator import get_agent_config
        final_temp = get_agent_config(agent_name).get("temperature", temperature)
    except Exception:
        final_temp = temperature

    # ── CHECK FOR EXTERNAL CONFIG ────────────────────────────────────
    # If api.py set an external config for this analysis run, use it
    ext_config = getattr(_tls, 'external_config', None)
    if ext_config:
        try:
            from src.utils.router_manager import _configs
            cfg = _configs.get(ext_config, {})
            if cfg.get("_external"):
                print(f"  [LLM] {agent_name} -> EXTERNAL '{ext_config}' | temp={final_temp}")
                return _build_external_llm(ext_config, final_temp)
        except Exception as e:
            print(f"  [LLM] External config check failed: {e} - falling back to local")

    # ── CHECK FOR LOCAL STUDENT CONFIG ──────────────────────────────
    selected_config = getattr(_tls, 'selected_config', None)
    if selected_config:
        try:
            from src.utils.router_manager import get_router
            router = get_router(selected_config)
            if router:
                print(f"  [LLM] {agent_name} -> LOCAL CONFIG '{selected_config}' via LiteLLM Router | temp={final_temp}")
                return RouterChatModel(
                    router=router,
                    config_name=selected_config,
                    temperature=final_temp
                )
        except Exception as e:
            print(f"  [LLM] Local config check failed: {e} - falling back to default configurator")

    # ── NORMAL LOCAL CONFIG FLOW ────────────────────────────────────
    # Get active model from configurator
    active = get_active_llm()
    primary_id = active["id"]

    # ── INTELLIGENT ROUTING ──────────────────────────────────────
    # Ask the router: should we use primary or its fallback?
    try:
        from src.utils.model_router import resolve
        actual_id = resolve(primary_id, agent_name)
    except Exception:
        actual_id = primary_id  # if router fails, use primary directly

    # If router switched us to a different model, get its entry
    if actual_id != primary_id:
        from src.utils.llm_configurator import _by_id
        model_entry = _by_id(actual_id) or active
    else:
        model_entry = active

    print(f"  [LLM] {agent_name} -> {model_entry['name']} ({model_entry['provider']}) | temp={final_temp}")

    return _build_llm(model_entry, final_temp)